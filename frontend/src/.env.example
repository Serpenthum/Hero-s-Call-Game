# Example environment file
# Copy this to frontend/.env.development.local (or .env.local) to override the defaults.
# These are BUILD-TIME environment variables read by Vite.

# DEFAULT BEHAVIOR (if no env file is used):
# - API and realtime URLs fall back to http://<page hostname>:8787 (the `wrangler dev` port)
# - Hero images are served by the site itself (the page origin)

# Local development against `wrangler dev`:
# VITE_API_BASE_URL=http://127.0.0.1:8787
# VITE_SOCKET_URL=http://127.0.0.1:8787

# Production: the Worker URL (workers.dev)
# VITE_API_BASE_URL=https://<your-worker>.workers.dev
# VITE_SOCKET_URL=https://<your-worker>.workers.dev

# Optional: only set if hero images are hosted somewhere other than the site itself
# VITE_IMAGE_BASE_URL=
